# GEMINI_API_KEY: Secure backend API key for automated expedition concierge & route assistance.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Production origin URL for canonical links, CORS allowlist, and booking webhooks.
APP_URL="MY_APP_URL"

# ==============================================================================
# SERVER-SIDE ENQUIRY API (/api/enquiry) — OPTIONAL PERSISTENCE & EMAIL PROVIDERS
# Configure any one storage adapter and any one email provider in Vercel Project
# Settings -> Environment Variables. Never expose these keys with VITE_ prefixes.
# ==============================================================================

# 1. Email Notification Recipient & Sender
MTE_NOTIFY_TO_EMAIL="mtejalpaiguri@gmail.com"
MTE_NOTIFY_FROM_EMAIL="MyTravelExpert Concierge <concierge@mytravelexpert.tech>"

# 2. Email Notification Provider (Choose ONE: Resend, SendGrid, Web3Forms, or Formspree)
RESEND_API_KEY=""
SENDGRID_API_KEY=""
WEB3FORMS_ACCESS_KEY=""
FORMSPREE_ENDPOINT=""

# 3. Persistent Cloud Storage Adapter (Choose ONE or MORE: Vercel KV/Upstash, Supabase, or Webhook)
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ENQUIRIES_TABLE="mte_enquiries"
MTE_ENQUIRY_WEBHOOK_URL=""
MTE_WEBHOOK_SECRET=""


